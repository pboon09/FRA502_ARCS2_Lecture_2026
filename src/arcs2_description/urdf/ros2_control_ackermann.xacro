<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="steering_joint" params="name">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">-0.6</param>
        <param name="max">0.6</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="drive_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="free_wheel_joint" params="name">
    <joint name="${name}">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:steering_joint name="front_left_steering_joint"/>
    <xacro:steering_joint name="front_right_steering_joint"/>
    <xacro:drive_joint name="rear_left_wheel_joint"/>
    <xacro:drive_joint name="rear_right_wheel_joint"/>
    <xacro:free_wheel_joint name="front_left_wheel_joint"/>
    <xacro:free_wheel_joint name="front_right_wheel_joint"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arcs2_bringup)/config/ackermann_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
